<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 사용자 LaunchAgent 틀. scripts/install-launchd.sh가 __CHECKOUT__과 __LOGS__를 절대 경로로 채워
     ~/Library/LaunchAgents에 둔다. 비밀값과 환경변수는 넣지 않는다. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.pr-proof.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__CHECKOUT__/scripts/start.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__CHECKOUT__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>StandardOutPath</key>
	<string>__LOGS__/server.log</string>
	<key>StandardErrorPath</key>
	<string>__LOGS__/server.log</string>
</dict>
</plist>
