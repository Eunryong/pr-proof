# 샌드박스 pytest에 --cov-config로 넘기는 파이프라인 쪽 coverage 설정.
# coverage.xml의 경로를 컨테이너 기준(/work/...)이 아니라 리포 기준 상대 경로로 남긴다.
# 대상 리포의 coverage 설정은 쓰지 않는다 (docs/DESIGN.md F6).
[run]
relative_files = True
source = .
omit =
    .venv/*
    .pipeline-out/*
data_file = .pipeline-out/.coverage

[report]
# __init__.py가 없는 폴더(src/ 구조, 스크립트 폴더)의 파일도 찾는다. 테스트가 import하지 않은
# 파일이 coverage.xml에서 빠지면 바뀐 줄 커버리지의 분모에서 빠져 숫자가 틀린다.
include_namespace_packages = True
